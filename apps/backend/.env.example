# Backend process
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL local development credentials. Use a dedicated role outside local development.
# Keep PGPASSWORD and the password embedded in DATABASE_URL in sync.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=flaremailer
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/flaremailer

# FastAPI
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_ECHO=false
SESSION_SECRET=development-only-change-me-32-bytes
SESSION_COOKIE_NAME=flaremailer_session
SESSION_MAX_AGE_SECONDS=1209600
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=5242880

# Platform key used to encrypt project API tokens stored in PostgreSQL.
# Generate a unique value with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=development-only-provider-credential-key-change-me

# Cloudflare Email Service platform behavior. Account IDs and API tokens are entered
# per project in the UI and are never process environment variables.
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_TIMEOUT_SECONDS=15

# Durable outbox worker
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=4
WORKER_BACKOFF_SECONDS=5,30,120
